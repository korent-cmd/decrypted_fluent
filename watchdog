        sel = ask(
            "Which to watch? "
            "(numbers, 'a' for all confident ones)",
            "a"
        )

        if sel.lower().startswith("a"):

            chosen = [
                c for c in cands
                if c.confidence >= MIN_CONFIDENCE
            ] or cands

        else:

            idxs = [
                int(x)
                for x in re.findall(
                    r"\d+",
                    sel
                )
            ]

            chosen = [
                cands[i - 1]
                for i in idxs
