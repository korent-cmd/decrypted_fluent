# ==============================================================================

def main() -> int:

    # Headless shortcut:
    # `python3 rw.py start`
    if (
        len(sys.argv) > 1
        and sys.argv[1] in (
            "start",
            "run"
        )
    ):

        app = App()

        if not app.targets:

            err(
                "No config found. "
                "Run without arguments to set up."
            )

            return 1

        Watchdog(
            app.sh,
            app.targets,
            app.interval,
            app.hang
        ).run()

        return 0

    if (
        not sys.stdin.isatty()
        or not sys.stdout.isatty()
    ):

        if C._on:
            App.toggle_plain()

        warn(
            "Terminal capabilities not detected "
            "— running in plain mode."
        )

        warn(
            "If input doesn't respond, use: "
            "python3 rw.py start "
            "(after Auto setup)."
        )

    try:
        App().menu()

    except Quit:

        print(
            f"\n  {C.DIM}"
            f"input closed, exiting"
            f"{C.RESET}\n"
        )

    except KeyboardInterrupt:
        print()

    finally:
        Screen.show_cursor()

    return 0


if __name__ == "__main__":

    try:
        sys.exit(main())

    finally:

        if _old_termios is not None:

            try:
                termios.tcsetattr(
                    sys.stdin.fileno(),
                    termios.TCSANOW,
                    _old_termios
                )
            except Exception:
                pass
