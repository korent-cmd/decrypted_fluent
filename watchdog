def save_config(
    targets: List[Target],
    interval: int,
    hang: bool
) -> None:

    data = {
        "check_interval_sec": interval,
        "hang_detection": hang,
        "targets": [
            t.to_config()
            for t in targets
        ]
    }

    with open(CONFIG_PATH, "w") as f:
        json.dump(
            data,
            f,
            indent=2
        )


def load_config() -> Tuple[
    List[Target],
    int,
    bool
]:

    if not os.path.exists(CONFIG_PATH):
        return [], 20, True

    try:
        with open(CONFIG_PATH) as f:
            data = json.load(f)

    except (
        json.JSONDecodeError,
        OSError
    ):
        return [], 20, True

    targets = []

    for raw in data.get(
        "targets",
        []
    ):

        try:
            targets.append(
                Target(**raw)
            )
        except TypeError:
            continue

    return (
        targets,
        int(
            data.get(
                "check_interval_sec",
                20
            )
        ),
        bool(
            data.get(
                "hang_detection",
                True
            )
        )
    )


def parse_place_id(raw: str) -> str:
    """Accept bare ID or full Roblox URL."""

    raw = raw.strip()

    m = re.search(
        r"/games/(\d+)",
        raw
    )

    if m:
        return m.group(1)

    m = re.search(
        r"placeId=(\d+)",
        raw,
        re.I
    )

    if m:
        return m.group(1)

    digits = re.sub(
        r"\D",
        "",
        raw
    )

    return digits


def parse_private_link(raw: str) -> str:
    m = re.search(
        r"privateServerLinkCode=([A-Za-z0-9_-]+)",
        raw
    )

    return m.group(1) if m else ""


