@dataclass
class Target:
    package: str
    user_id: int = 0
    place_id: str = ""
    private_link: str = ""
    rejoin_interval_min: int = 45
    label: str = ""
    enabled: bool = True

    last_rejoin: Optional[datetime] = field(default=None, repr=False, compare=False)
    last_cpu: Optional[int] = field(default=None, repr=False, compare=False)
    stale_ticks: int = field(default=0, repr=False, compare=False)
    fail_streak: int = field(default=0, repr=False, compare=False)
    cooldown_until: Optional[datetime] = field(default=None, repr=False, compare=False)
    restarts: int = field(default=0, repr=False, compare=False)
    status: str = field(default="?", repr=False, compare=False)

    @property
    def name(self) -> str:
        base = self.label or self.package
        return f"{base}@u{self.user_id}" if self.user_id else base

    def to_config(self) -> dict:
        d = asdict(self)
        for k in ("last_rejoin", "last_cpu", "stale_ticks", "fail_streak",
                  "cooldown_until", "restarts", "status"):
            d.pop(k, None)
        return d


class Controller:
    HANG_TICKS = 3

    def __init__(self, sh: Shell, hang_detection: bool = True):
        self.sh = sh
        self.hang_detection = hang_detection

    def pids(self, t: Target) -> List[int]:
        out = self.sh.out(f"pidof {shlex.quote(t.package)}", timeout=15)
        return [int(x) for x in out.split() if x.isdigit()]

    def cpu_ticks(self, pid: int) -> Optional[int]:
        out = self.sh.out(f"cat /proc/{pid}/stat 2>/dev/null", timeout=15)
        m = re.search(r"\)\s+\S+\s+(.*)", out)
        if not m:
            return None
        f = m.group(1).split()
        try:
            return int(f[10]) + int(f[11])
        except (IndexError, ValueError):
            return None

    def error_dialog(self) -> bool:
        return bool(self.sh.out(
            "dumpsys window 2>/dev/null | grep -m3 -iE "
            "'Application Error|aerr|anr |isn.t responding|has stopped'",
            timeout=25).strip())

    def dismiss_dialog(self) -> None:
        self.sh.run("input keyevent KEYCODE_ENTER", timeout=15)
        time.sleep(0.5)
        self.sh.run("input keyevent KEYCODE_BACK", timeout=15)

    def wake(self) -> None:
        out = self.sh.out(
            "dumpsys power 2>/dev/null | grep -m1 -E 'mWakefulness|Display Power'",
            timeout=20)
        if any(s in out for s in ("Asleep", "Dozing", "state=OFF")):
            self.sh.run("input keyevent KEYCODE_WAKEUP", timeout=15)
            time.sleep(0.6)
            self.sh.run("input keyevent KEYCODE_MENU", timeout=15)

    def force_stop(self, t: Target) -> None:
        uf = f"--user {t.user_id}" if t.user_id else ""
        self.sh.run(f"am force-stop {uf} {shlex.quote(t.package)}", timeout=25)

    def launch(self, t: Target) -> bool:
        uf = f"--user {t.user_id}" if t.user_id else ""
        urls: List[str] = []
        if t.private_link and t.place_id:
            urls.append(f"https://www.roblox.com/games/{t.place_id}"
                        f"?privateServerLinkCode={t.private_link}")
        if t.place_id:
            urls += [u.format(place_id=t.place_id) for u in LAUNCH_URL_TEMPLATES]

        for url in urls:
            self.sh.run(f"am start {uf} -a android.intent.action.VIEW "
                        f"-d {shlex.quote(url)} {shlex.quote(t.package)}", timeout=30)
            if self._wait(t, 20):
                return True
        self.sh.run(f"monkey {uf} -p {shlex.quote(t.package)} "
                    f"-c android.intent.category.LAUNCHER 1", timeout=30)
        return self._wait(t, 25)

    def _wait(self, t: Target, seconds: int) -> bool:
        end = time.time() + seconds
        while time.time() < end:
            if self.pids(t):
                return True
            time.sleep(2)
        return False

    def health(self, t: Target) -> str:
        pids = self.pids(t)
        if not pids:
            return "dead"
        if self.error_dialog():
            return "dialog"
        if self.hang_detection:
            ticks = self.cpu_ticks(pids[0])
            if ticks is not None:
                if t.last_cpu is not None and ticks <= t.last_cpu:
                    t.stale_ticks += 1
                else:
                    t.stale_ticks = 0
                t.last_cpu = ticks
                if t.stale_ticks >= self.HANG_TICKS:
                    return "hung"
        return "ok"

    def restart(self, t: Target, reason: str) -> bool:
        logline(f"[{t.name}] restarting ({reason})", "WARN")
        self.wake()
        if reason == "dialog":
            self.dismiss_dialog()
            time.sleep(1)
        self.force_stop(t)
        time.sleep(2.5)
        success = self.launch(t)

        t.last_rejoin = datetime.now()
        t.last_cpu = None
        t.stale_ticks = 0
        t.restarts += 1

        if success:
            t.fail_streak = 0
            t.status = "running"
            logline(f"[{t.name}] rejoined (restart #{t.restarts})", "OK")
        else:
            t.fail_streak += 1
            t.status = "failed"
            back = min(300, 30 * (2 ** (t.fail_streak - 1))) + random.uniform(0, 10)
            t.cooldown_until = datetime.now() + timedelta(seconds=back)
            logline(f"[{t.name}] launch failed x{t.fail_streak}, "
                    f"waiting {int(back)}s", "ERR")
        return success


# ==============================================================================
# WATCHDOG LOOP
# ==============================================================================

class Watchdog:
    def __init__(self, sh: Shell, targets: List[Target], interval: int,
                 hang_detection: bool):
        self.sh = sh
        self.targets = [t for t in targets if t.enabled]
        self.interval = interval
        self.ctl = Controller(sh, hang_detection)
        self.running = True
        self.started = datetime.now()

    def stop(self, *_a) -> None:
        self.running = False

    def tick(self, t: Target) -> None:
        now = datetime.now()
        if t.cooldown_until and now < t.cooldown_until:
            t.status = "cooldown"
            return

        state = self.ctl.health(t)
        if state in ("dead", "hung", "dialog"):
            t.status = state
            self.ctl.restart(t, state)
            return

        if t.last_rejoin is None:
            # First pass: make sure it's actually in the right place, not just
            # sitting on the Roblox home screen from whenever it was opened.
            self.ctl.restart(t, "initial join")
            return

        if (t.rejoin_interval_min > 0 and
                (now - t.last_rejoin) >= timedelta(minutes=t.rejoin_interval_min)):
            self.ctl.restart(t, "scheduled")
        else:
            t.status = "running"

    def header(self) -> None:
        up = str(datetime.now() - self.started).split(".")[0]
        total = sum(t.restarts for t in self.targets)
        clear()
        print(f"{C.BLUE}{C.BOLD}  ROBLOX WATCHDOG{C.RESET}   "
              f"{C.DIM}uptime {up} · {total} restarts · "
              f"root={self.sh.has_root}{C.RESET}")
        hr("=")
        for t in self.targets:
            color = {"running": C.GREEN, "cooldown": C.YELLOW,
                     "failed": C.RED, "dead": C.RED, "hung": C.YELLOW,
                     "dialog": C.YELLOW}.get(t.status, C.DIM)
            nxt = "-"
            if t.last_rejoin and t.rejoin_interval_min > 0:
                remain = (t.last_rejoin +
                          timedelta(minutes=t.rejoin_interval_min) - datetime.now())
                nxt = str(max(remain, timedelta(0))).split(".")[0]
            print(f"  {color}●{C.RESET} {t.name[:26]:<26} "
                  f"{color}{t.status:<9}{C.RESET} "
                  f"{C.DIM}restarts={t.restarts:<3} next rejoin in {nxt}{C.RESET}")
        hr("=")
        print(f"  {C.DIM}Ctrl+C to stop and return to the menu{C.RESET}\n")

    def run(self) -> None:
        signal.signal(signal.SIGINT, self.stop)
        signal.signal(signal.SIGTERM, self.stop)
        try:
            subprocess.run(["termux-wake-lock"], capture_output=True, timeout=10)
        except Exception:
            pass

        logline(f"watchdog started on {len(self.targets)} target(s)", "OK")
        try:
            while self.running:
                for t in self.targets:
                    if not self.running:
                        break
                    try:
                        self.tick(t)
                    except Exception as e:
                        logline(f"[{t.name}] error: {e}", "ERR")
                self.header()
                slept = 0.0
                step = 0.5
                total = self.interval + random.uniform(0, 3)
                while self.running and slept < total:
                    time.sleep(step)
                    slept += step
        except KeyboardInterrupt:
            self.running = False
        finally:
            try:
                subprocess.run(["termux-wake-unlock"], capture_output=True, timeout=10)
            except Exception:
                pass
            signal.signal(signal.SIGINT, signal.default_int_handler)

        up = str(datetime.now() - self.started).split(".")[0]
        total = sum(t.restarts for t in self.targets)
        print()
        ok(f"Stopped after {up} · {total} restart(s) total")


