@dataclass
class Candidate:
    package: str
    user_id: int = 0
    strategies: Set[str] = field(default_factory=set)
    label: Optional[str] = None

    @property
    def confidence(self) -> int:
        return len(self.strategies)

    @property
    def display(self) -> str:
        return self.label or self.package


class Detector:

    def __init__(
        self,
        sh: Shell,
        markers: Optional[Sequence[str]] = None
    ):
        self.sh = sh
        self.markers = [
            m.lower()
            for m in (markers or PACKAGE_MARKERS)
        ]

        self.found: Dict[
            Tuple[str, int],
            Candidate
        ] = {}

    def _matches(self, text: str) -> bool:
        t = text.lower()
        return any(m in t for m in self.markers)

    def _blocked(self, pkg: str) -> bool:
        p = pkg.lower()
        return any(b in p for b in CLONER_BLOCKLIST)

    def _add(
        self,
        pkg: str,
        uid: int,
        strat: str,
        label: Optional[str] = None
    ) -> None:

        pkg = pkg.strip()

        if not pkg or "." not in pkg or self._blocked(pkg):
            return

        key = (pkg, uid)

        c = self.found.get(key) or Candidate(
            package=pkg,
            user_id=uid
        )

        c.strategies.add(strat)

        if label and not c.label:
            c.label = label

        self.found[key] = c

    def list_users(self) -> List[int]:
        out = self.sh.cached("pm list users")

        ids = [
            int(m)
            for m in re.findall(
                r"UserInfo\{(\d+):",
                out
            )
        ]

        return sorted(set(ids)) or [0]

    def _packages(self, uid: int) -> List[str]:
        out = self.sh.cached(
            f"pm list packages --user {uid}"
        )

        if (
            not out.strip()
            or "Error" in out
            or "Exception" in out
        ):
            out = (
                self.sh.cached("pm list packages")
                if uid == 0
                else ""
            )

        return [
            l.split("package:", 1)[1].strip()
            for l in out.splitlines()
            if l.startswith("package:")
        ]

    # --------------------------------------------------------------------------
    # strategies
    # --------------------------------------------------------------------------

    def s_name(self, uid: int) -> None:
        for pkg in self._packages(uid):
            if self._matches(pkg):
                self._add(pkg, uid, "name")

    def s_url_handler(self, uid: int) -> None:
        """Clones keep Roblox's intent filters even when renamed."""

        for probe in (
            f"cmd package query-activities --user {uid} "
            f"-a android.intent.action.VIEW "
            f"-d {shlex.quote(ROBLOX_PROBE_URL)}",

            f"cmd package query-activities --user {uid} "
            f"-a android.intent.action.VIEW "
            f"-d {shlex.quote('roblox://placeID=1818')}",

            f"pm query-activities --user {uid} "
            f"-a android.intent.action.VIEW "
            f"-d {shlex.quote(ROBLOX_PROBE_URL)}",
        ):
            out = self.sh.out(probe, timeout=30)

            if not out.strip():
                continue

            for pkg in re.findall(
                r"packageName=([A-Za-z0-9_.]+)",
                out
            ):
                self._add(pkg, uid, "url_handler")

            for pkg in re.findall(
                r"^\s*([A-Za-z0-9_.]+)/[A-Za-z0-9_.$]+",
                out,
                re.M
            ):
                self._add(pkg, uid, "url_handler")

    def s_apk_path(self, uid: int) -> None:
        out = self.sh.cached(
            f"pm list packages -f --user {uid}"
        )

        if not out.strip():
            out = self.sh.cached(
                "pm list packages -f"
            )

        for line in out.splitlines():

            if (
                not line.startswith("package:")
                or "=" not in line
            ):
                continue

            path, pkg = line.split(
                "package:",
                1
            )[1].rsplit("=", 1)

            if self._matches(path):
                self._add(pkg, uid, "apk_path")

    def s_data_dir(self, uid: int) -> None:
        if not self.sh.has_root:
            return

        base = (
            "/data/data"
            if uid == 0
            else f"/data/user/{uid}"
        )

        for name in self.sh.out(
            f"ls {base} 2>/dev/null",
            timeout=30
        ).split():

            if self._matches(name):
                self._add(name, uid, "data_dir")

        hits = self.sh.out(
            f"find {base} -maxdepth 3 "
            f"-iname '*roblox*' 2>/dev/null "
            f"| head -n 200",
            timeout=60
        )

        depth = len(
            base.strip("/").split("/")
        )

        for path in hits.splitlines():
            parts = path.strip().strip("/").split("/")

            if len(parts) > depth:
                self._add(
                    parts[depth],
                    uid,
                    "data_dir"
                )

    def s_process(self, uid: int) -> None:
        out = self.sh.out(
            "ps -A -o NAME 2>/dev/null "
            "|| ps -A 2>/dev/null",
            timeout=25
        )

        for tok in out.split():
            if self._matches(tok) and "." in tok:
                self._add(
                    tok.split(":")[0],
                    uid,
                    "process"
                )

    def s_dumpsys(self, uid: int) -> None:
        pkgs = set(self._packages(uid))

        if not pkgs:
            return

        pattern = "|".join(self.markers)

        out = self.sh.out(
            "dumpsys package packages 2>/dev/null "
            f"| grep -iE 'Package \\[|{pattern}'",
            timeout=90
        )

        current = None

        for line in out.splitlines():

            m = re.search(
                r"Package \[([A-Za-z0-9_.]+)\]",
                line
            )

            if m:
                current = m.group(1)
                continue

            if (
                current
                and current in pkgs
                and self._matches(line)
            ):
                self._add(
                    current,
                    uid,
                    "dumpsys"
                )

    def resolve_labels(self) -> None:
        for c in self.found.values():

            out = self.sh.out(
                f"dumpsys package "
                f"{shlex.quote(c.package)} 2>/dev/null "
                f"| grep -m1 -i applicationLabel",
                timeout=20
            )

            m = re.search(
                r"applicationLabel=(.+)",
                out
            )

            if m:
                c.label = m.group(1).strip()

    def foreground(self) -> Optional[str]:

        for cmd in (
            "dumpsys window 2>/dev/null "
            "| grep -m1 -E "
            "'mCurrentFocus|mFocusedApp'",

            "dumpsys activity activities 2>/dev/null "
            "| grep -m1 -E "
            "'ResumedActivity|mResumedActivity'",
        ):

            m = re.search(
                r"([A-Za-z0-9_.]+)/[A-Za-z0-9_.$]+",
                self.sh.out(cmd, timeout=25)
            )

            if m and "." in m.group(1):
                return m.group(1)

        return None

    def detect(
        self,
        deep: bool = True,
        verbose: bool = True
    ) -> List[Candidate]:

        self.sh.clear_cache()

        users = self.list_users()

        if verbose:
            info(
                f"Android user profiles found: {users}"
            )

        steps = [
            ("package names", self.s_name),
            ("deep-link handlers", self.s_url_handler),
            ("apk paths", self.s_apk_path),
            ("app data folders", self.s_data_dir),
            ("running processes", self.s_process),
        ]

        if deep:
            steps.append(
                ("package records (slow)", self.s_dumpsys)
            )

        for uid in users:

            for name, fn in steps:

                if verbose:
                    spinner(
                        f"scanning {name} "
                        f"(user {uid})"
                    )

                try:
                    fn(uid)
                except Exception as e:
                    if verbose:
                        warn(
                            f"{name} failed: {e}"
                        )

        fg = self.foreground()

        if fg and not self._blocked(fg):

            if (fg, 0) in self.found:
                self.found[
                    (fg, 0)
                ].strategies.add(
                    "foreground"
                )

            elif self._matches(fg):
                self._add(
                    fg,
                    0,
                    "foreground"
                )

        self.resolve_labels()

        return sorted(
            self.found.values(),
            key=lambda c: (
                -c.confidence,
                c.user_id,
                c.package
            )
        )


