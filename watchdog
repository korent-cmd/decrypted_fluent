class C:
    """ANSI colors, auto-disabled when output isn't a terminal."""
    _on = sys.stdout.isatty()
    RESET = "\033[0m" if _on else ""
    BOLD = "\033[1m" if _on else ""
    DIM = "\033[2m" if _on else ""
    RED = "\033[31m" if _on else ""
    GREEN = "\033[32m" if _on else ""
    YELLOW = "\033[33m" if _on else ""
    BLUE = "\033[36m" if _on else ""
    MAGENTA = "\033[35m" if _on else ""


def clear() -> None:
    print("\033[2J\033[H", end="")


def banner() -> None:
    print(f"{C.BLUE}{C.BOLD}")
    print("  ____  _     _       __        __    _       _         _")
    print(" |  _ \\| |   | |_  __ \\ \\      / /_ _| |_ ___| |__   __| | ___   __ _")
    print(" | |_) | |   | \\ \\/ /  \\ \\ /\\ / / _` | __/ __| '_ \\ / _` |/ _ \\ / _` |")
    print(" |  _ <| |___| |>  <    \\ V  V / (_| | || (__| | | | (_| | (_) | (_| |")
    print(" |_| \\_\\_____|_/_/\\_\\    \\_/\\_/ \\__,_|\\__\\___|_| |_|\\__,_|\\___/ \\__, |")
    print(f"                                                               |___/")
    print(f"{C.RESET}{C.DIM}                   v{VERSION}  ·  termux edition  ·  no adb{C.RESET}\n")


def hr(char: str = "-") -> None:
    print(C.DIM + char * 64 + C.RESET)


def ok(msg: str) -> None:
    print(f"  {C.GREEN}[+]{C.RESET} {msg}")


def warn(msg: str) -> None:
    print(f"  {C.YELLOW}[!]{C.RESET} {msg}")


def err(msg: str) -> None:
    print(f"  {C.RED}[x]{C.RESET} {msg}")


def info(msg: str) -> None:
    print(f"  {C.BLUE}[*]{C.RESET} {msg}")


def ask(prompt: str, default: str = "") -> str:
    suffix = f" {C.DIM}[{default}]{C.RESET}" if default else ""
    try:
        val = input(f"  {C.BOLD}>{C.RESET} {prompt}{suffix}: ").strip()
    except EOFError:
        return default
    return val or default


def ask_yes(prompt: str, default: bool = True) -> bool:
    d = "Y/n" if default else "y/N"
    val = ask(f"{prompt} ({d})").lower()
    if not val:
        return default
    return val.startswith("y")


def ask_int(prompt: str, default: int, lo: int = 0, hi: int = 10 ** 9) -> int:
    while True:
        raw = ask(prompt, str(default))
        try:
            v = int(raw)
            if lo <= v <= hi:
                return v
            warn(f"Enter a number between {lo} and {hi}.")
        except ValueError:
            warn("Numbers only.")


def pause() -> None:
    try:
        input(f"\n  {C.DIM}press Enter to continue{C.RESET}")
    except EOFError:
        pass


def spinner(msg: str) -> None:
    print(f"  {C.DIM}... {msg}{C.RESET}")


def logline(msg: str, level: str = "INFO") -> None:
    stamp = datetime.now().strftime("%H:%M:%S")
    color = {"INFO": C.RESET, "OK": C.GREEN, "WARN": C.YELLOW,
             "ERR": C.RED}.get(level, C.RESET)
    print(f"  {C.DIM}{stamp}{C.RESET} {color}{msg}{C.RESET}")
    try:
        with open(LOG_PATH, "a") as f:
            f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} [{level}] {msg}\n")
    except OSError:
        pass


