try:
    import termios
    _fd = sys.stdin.fileno()
    _old_termios = termios.tcgetattr(_fd)
    _sane = termios.tcgetattr(_fd)

    _sane[3] |= (termios.ICANON | termios.ECHO | termios.ISIG)
    termios.tcsetattr(_fd, termios.TCSANOW, _sane)
except Exception:
    _old_termios = None


class _CRLFStdout:
    """Passthrough wrapper that guarantees '\\n' returns to column 0."""

    def __init__(self, wrapped):
        self._w = wrapped

    def write(self, s: str) -> int:
        return self._w.write(s.replace("\n", "\r\n"))

    def flush(self) -> None:
        self._w.flush()

    def isatty(self) -> bool:
        try:
            return self._w.isatty()
        except Exception:
            return False

    def fileno(self) -> int:
        return self._w.fileno()


sys.stdout = _CRLFStdout(sys.stdout)


def _resane_tty() -> None:
    if _old_termios is None:
        return
    try:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSANOW, _sane)
    except Exception:
        pass


