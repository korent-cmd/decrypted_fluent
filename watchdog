class Quit(Exception):
    pass


def ask(prompt: str, default: str = "") -> str:
    suffix = f" {C.DIM}[{default}]{C.RESET}" if default else ""

    try:
        val = input(
            f"  {C.BOLD}>{C.RESET} {prompt}{suffix}: "
        ).strip()
    except EOFError:
        raise Quit()
    except KeyboardInterrupt:
        raise Quit()

    return val or default


def ask_yes(prompt: str, default: bool = True) -> bool:
    d = "Y/n" if default else "y/N"
    val = ask(f"{prompt} ({d})").lower()

    if not val:
        return default

    return val.startswith("y")


def ask_int(
    prompt: str,
    default: int,
    lo: int = 0,
    hi: int = 10 ** 9
) -> int:
    while True:
        raw = ask(prompt, str(default))

        try:
            v = int(raw)

            if lo <= v <= hi:
                return v

            warn(f"Enter a number between {lo} and {hi}.")

        except ValueError:
            warn("Numbers only.")


def pause() -> None:
    try:
        input(f"\n  {C.DIM}press Enter to continue{C.RESET}")
    except EOFError:
        raise Quit()
    except KeyboardInterrupt:
        pass


def spinner(msg: str) -> None:
    print(f"  {C.DIM}... {msg}{C.RESET}")


def logline(msg: str, level: str = "INFO") -> None:
    stamp = datetime.now().strftime("%H:%M:%S")

    color = {
        "INFO": C.RESET,
        "OK": C.GREEN,
        "WARN": C.YELLOW,
        "ERR": C.RED,
    }.get(level, C.RESET)

    entry = (
        f"  {C.DIM}{stamp}{C.RESET} "
        f"{color}{msg}{C.RESET}"
    )

    if LIVE_MODE:
        LOG_BUFFER.append(entry)
        del LOG_BUFFER[:-200]
    else:
        print(entry)

    try:
        with open(LOG_PATH, "a") as f:
            f.write(
                f"{datetime.now():%Y-%m-%d %H:%M:%S} "
                f"[{level}] {msg}\n"
            )
    except OSError:
        pass


