class C:
    """ANSI colors, auto-disabled when output isn't a terminal."""

    _on = sys.stdout.isatty()

    RESET = "\033[0m" if _on else ""
    BOLD = "\033[1m" if _on else ""
    DIM = "\033[2m" if _on else ""
    RED = "\033[31m" if _on else ""
    GREEN = "\033[32m" if _on else ""
    YELLOW = "\033[33m" if _on else ""
    BLUE = "\033[36m" if _on else ""
    MAGENTA = "\033[35m" if _on else ""


def clear() -> None:
    if not C._on:
        return

    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()


class Screen:
    _last: Optional[str] = None
    _hidden = False

    @classmethod
    def hide_cursor(cls) -> None:
        if C._on and not cls._hidden:
            sys.stdout.write("\033[?25l")
            sys.stdout.flush()
            cls._hidden = True

    @classmethod
    def show_cursor(cls) -> None:
        if C._on and cls._hidden:
            sys.stdout.write("\033[?25h")
            sys.stdout.flush()
            cls._hidden = False

    @classmethod
    def render(cls, lines: List[str]) -> None:
        frame = "\n".join(lines)

        if frame == cls._last:
            return

        cls._last = frame

        if not C._on:
            print(frame)
            return

        buf = (
            "\033[H"
            + "\r\n".join(ln + "\033[K" for ln in lines)
            + "\033[J"
        )

        sys.stdout.write(buf)
        sys.stdout.flush()

    @classmethod
    def reset(cls) -> None:
        cls._last = None


