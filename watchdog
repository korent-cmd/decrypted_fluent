    @staticmethod
    def toggle_plain() -> None:
        """Escape hatch for terminals that mangle ANSI escapes."""

        C._on = not C._on

        for attr, code in (
            ("RESET", "\033[0m"),
            ("BOLD", "\033[1m"),
            ("DIM", "\033[2m"),
            ("RED", "\033[31m"),
            ("GREEN", "\033[32m"),
            ("YELLOW", "\033[33m"),
            ("BLUE", "\033[36m"),
            ("MAGENTA", "\033[35m"),
        ):

            setattr(
                C,
                attr,
                code if C._on else ""
            )

        Screen.reset()

        ok(
            "Colors "
            + (
                "enabled"
                if C._on
                else "disabled"
            )
        )

        time.sleep(1.0)


