@dataclass
class Target:
    package: str
    user_id: int = 0
    place_id: str = ""
    private_link: str = ""
    rejoin_interval_min: int = 45
    label: str = ""
    enabled: bool = True

    last_rejoin: Optional[datetime] = field(
        default=None,
        repr=False,
        compare=False
    )

    last_cpu: Optional[int] = field(
        default=None,
        repr=False,
        compare=False
    )

    stale_ticks: int = field(
        default=0,
        repr=False,
        compare=False
    )

    stale_since: Optional[datetime] = field(
        default=None,
        repr=False,
        compare=False
    )

    fail_streak: int = field(
        default=0,
        repr=False,
        compare=False
    )

    cooldown_until: Optional[datetime] = field(
        default=None,
        repr=False,
        compare=False
    )

    restarts: int = field(
        default=0,
        repr=False,
        compare=False
    )

    status: str = field(
        default="?",
        repr=False,
        compare=False
    )

    @property
    def name(self) -> str:
        base = self.label or self.package

        return (
            f"{base}@u{self.user_id}"
            if self.user_id
            else base
        )

    def to_config(self) -> dict:
        d = asdict(self)

        for k in (
            "last_rejoin",
            "last_cpu",
            "stale_ticks",
            "stale_since",
            "fail_streak",
            "cooldown_until",
            "restarts",
            "status",
        ):
            d.pop(k, None)

        return d


class Controller:

    HANG_TICKS = 6
    HANG_MIN_SECONDS = 240

    def __init__(
        self,
        sh: Shell,
        hang_detection: bool = True
    ):
        self.sh = sh
        self.hang_detection = hang_detection

    def pids(self, t: Target) -> List[int]:
        out = self.sh.out(
            f"pidof {shlex.quote(t.package)}",
            timeout=15
        )

        return [
            int(x)
            for x in out.split()
            if x.isdigit()
        ]

    def cpu_ticks(
        self,
        pid: int
    ) -> Optional[int]:

        out = self.sh.out(
            f"cat /proc/{pid}/stat 2>/dev/null",
            timeout=15
        )

        m = re.search(
            r"\)\s+\S+\s+(.*)",
            out
        )

        if not m:
            return None

        f = m.group(1).split()

        try:
            return int(f[10]) + int(f[11])
        except (IndexError, ValueError):
            return None

    def error_dialog(self) -> bool:
        return bool(
            self.sh.out(
                "dumpsys window 2>/dev/null "
                "| grep -m3 -iE "
                "'Application Error|aerr|anr |"
                "isn.t responding|has stopped'",
                timeout=25
            ).strip()
        )

    def dismiss_dialog(self) -> None:
        self.sh.run(
            "input keyevent KEYCODE_ENTER",
            timeout=15
        )

        time.sleep(0.5)

        self.sh.run(
            "input keyevent KEYCODE_BACK",
            timeout=15
        )

    def wake(self) -> None:
        out = self.sh.out(
            "dumpsys power 2>/dev/null "
            "| grep -m1 -E "
            "'mWakefulness|Display Power'",
            timeout=20
        )

        if any(
            s in out
            for s in (
                "Asleep",
                "Dozing",
                "state=OFF"
            )
        ):
            self.sh.run(
                "input keyevent KEYCODE_WAKEUP",
                timeout=15
            )

            time.sleep(0.6)

            self.sh.run(
                "input keyevent KEYCODE_MENU",
                timeout=15
            )

    def force_stop(self, t: Target) -> None:
        uf = (
            f"--user {t.user_id}"
            if t.user_id
            else ""
        )

        self.sh.run(
            f"am force-stop {uf} "
            f"{shlex.quote(t.package)}",
            timeout=25
        )

    def launch(self, t: Target) -> bool:
        """Launch Roblox and explicitly pass the deep link."""

        uf = (
            f"--user {t.user_id}"
            if t.user_id
            else ""
        )

        urls: List[str] = []

        if t.place_id:
            urls.append(
                f"roblox://placeId={t.place_id}"
            )

            if t.private_link:
                urls.append(
                    f"https://www.roblox.com/games/start"
                    f"?placeId={t.place_id}"
                    f"&linkCode={t.private_link}"
                )

            urls.append(
                f"https://www.roblox.com/games/start"
                f"?placeId={t.place_id}"
            )

        for url in urls:

            cmd = (
                f"am start -W {uf} "
                f"-a android.intent.action.VIEW "
                f"-d {shlex.quote(url)} "
                f"-p {shlex.quote(t.package)}"
            )

            rc, out = self.sh.run(
                cmd,
                timeout=35
            )

            logline(
                f"[{t.name}] launch intent "
                f"rc={rc}: {url}",
                "INFO" if rc == 0 else "WARN"
            )

            if out.strip():
                compact = " ".join(
                    out.strip().split()
                )[:220]

                logline(
                    f"[{t.name}] am start: {compact}",
                    "INFO" if rc == 0 else "WARN"
                )

            if (
                "Error: Activity not started" in out
                or "does not exist" in out
            ):
                logline(
                    f"[{t.name}] {t.package} has no "
                    f"handler for this URL form, "
                    f"trying next",
                    "WARN"
                )
                continue

            if self._wait(t, 30):
                time.sleep(5)
                return True

        rc, out = self.sh.run(
            f"monkey {uf} "
            f"-p {shlex.quote(t.package)} "
            f"-c android.intent.category.LAUNCHER 1",
            timeout=30
        )

        logline(
            f"[{t.name}] launcher fallback rc={rc}",
            "INFO" if rc == 0 else "WARN"
        )

        return self._wait(t, 30)

    def _wait(
        self,
        t: Target,
        seconds: int
    ) -> bool:

        end = time.time() + seconds

        while time.time() < end:

            if self.pids(t):
                return True

            time.sleep(2)

        return False

    def health(self, t: Target) -> str:
        """
        Health detector.

        IMPORTANT:
        This function ONLY reports state.

        Watchdog.tick() deliberately does NOT use these states
        to trigger a restart.
        """

        pids = self.pids(t)

        if not pids:
            return "dead"

        if self.error_dialog():
            return "dialog"

        if self.hang_detection:

            ticks = self.cpu_ticks(pids[0])

            if ticks is not None:

                now = datetime.now()

                if (
                    t.last_cpu is not None
                    and ticks <= t.last_cpu
                ):
                    t.stale_ticks += 1

                    if t.stale_since is None:
                        t.stale_since = now

                else:
                    t.stale_ticks = 0
                    t.stale_since = None

                t.last_cpu = ticks

                elapsed = (
                    (now - t.stale_since).total_seconds()
                    if t.stale_since
                    else 0
                )

                if (
                    t.stale_ticks >= self.HANG_TICKS
                    and elapsed >= self.HANG_MIN_SECONDS
                ):
                    return "hung"

        return "ok"

    def restart(
        self,
        t: Target,
        reason: str
    ) -> bool:

        logline(
            f"[{t.name}] restarting ({reason})",
            "WARN"
        )

        self.wake()

        if reason == "dialog":
            self.dismiss_dialog()
            time.sleep(1)

        self.force_stop(t)

        time.sleep(2.5)

        success = self.launch(t)

        t.last_rejoin = datetime.now()
        t.last_cpu = None
        t.stale_ticks = 0
        t.stale_since = None
        t.restarts += 1

        if success:

            t.fail_streak = 0
            t.cooldown_until = None
            t.status = "running"

            logline(
                f"[{t.name}] rejoined "
                f"(restart #{t.restarts})",
                "OK"
            )

        else:

            t.fail_streak += 1
            t.status = "failed"

            back = (
                min(
                    300,
                    30 * (2 ** (t.fail_streak - 1))
                )
                + random.uniform(0, 10)
            )

            t.cooldown_until = (
                datetime.now()
                + timedelta(seconds=back)
            )

            logline(
                f"[{t.name}] launch failed "
                f"x{t.fail_streak}, "
                f"waiting {int(back)}s",
                "ERR"
            )

        return success


# ==============================================================================
# WATCHDOG LOOP
# ==============================================================================

class Watchdog:

    def __init__(
        self,
        sh: Shell,
        targets: List[Target],
        interval: int,
        hang_detection: bool
    ):
        self.sh = sh

        self.targets = [
            t for t in targets
            if t.enabled
        ]

        self.interval = interval
        self.ctl = Controller(
            sh,
            hang_detection
        )

        self.running = True
        self.started = datetime.now()

    def stop(self, *_a) -> None:
        self.running = False

    def tick(self, t: Target) -> None:
        """
        Timer-only rejoin logic.

        Behavior:

        1. First watchdog activation:
           -> join the configured place once.

        2. After the initial join:
           -> only rejoin when the timer expires.

        3. Crash / hang / dialog detection:
           -> display the state only.
           -> NEVER trigger a restart.

        4. rejoin_interval_min == 0:
           -> initial join only, no scheduled rejoining.
        """

        now = datetime.now()

        # ------------------------------------------------------------------
        # COOLDOWN
        # ------------------------------------------------------------------
        # Keep the existing launch-failure backoff. This prevents a failed
        # launch from being hammered repeatedly.
        if (
            t.cooldown_until
            and now < t.cooldown_until
        ):
            t.status = "cooldown"
            return

        # ------------------------------------------------------------------
        # INITIAL JOIN
        # ------------------------------------------------------------------
        # The very first activation ALWAYS joins the configured place.
        #
        # We intentionally do this before checking health. The detector
        # should not decide whether the first join happens.
        if t.last_rejoin is None:

            logline(
                f"[{t.name}] performing initial join",
                "INFO"
            )

            self.ctl.restart(
                t,
                "initial join"
            )

            return

        # ------------------------------------------------------------------
        # HEALTH DETECTION
        # ------------------------------------------------------------------
        # This is DISPLAY ONLY.
        #
        # Even if health() returns:
        #   dead
        #   hung
        #   dialog
        #
        # we do NOT restart here.
        state = self.ctl.health(t)

        # ------------------------------------------------------------------
        # TIMER-ONLY REJOIN
        # ------------------------------------------------------------------
        # This is the ONLY automatic condition that can cause a rejoin.
        if (
            t.rejoin_interval_min > 0
            and (
                now - t.last_rejoin
            ) >= timedelta(
                minutes=t.rejoin_interval_min
            )
        ):

            t.status = "scheduled"

            self.ctl.restart(
                t,
                "scheduled"
            )

            return

        # ------------------------------------------------------------------
        # DISPLAY HEALTH STATE
        # ------------------------------------------------------------------

        if state == "dead":
            t.status = "dead"

        elif state == "hung":
            t.status = "hung"

        elif state == "dialog":
            t.status = "dialog"

        else:
            t.status = "running"

    def frame(self) -> List[str]:
        up = str(
            datetime.now() - self.started
        ).split(".")[0]

        total = sum(
            t.restarts
            for t in self.targets
        )

        width = 64

        lines: List[str] = []

        lines.append(
            f"  {C.BLUE}{C.BOLD}"
            f"ROBLOX WATCHDOG"
            f"{C.RESET}   "
            f"{C.DIM}"
            f"uptime {up} · "
            f"{total} restarts · "
            f"root={self.sh.has_root}"
            f"{C.RESET}"
        )

        lines.append(
            C.DIM + "=" * width + C.RESET
        )

        for t in self.targets:

            color = {
                "running": C.GREEN,
                "cooldown": C.YELLOW,
                "failed": C.RED,
                "dead": C.RED,
                "hung": C.YELLOW,
                "dialog": C.YELLOW,
            }.get(
                t.status,
                C.DIM
            )

            nxt = "-"

            if (
                t.last_rejoin
                and t.rejoin_interval_min > 0
            ):

                remain = (
                    t.last_rejoin
                    + timedelta(
                        minutes=t.rejoin_interval_min
                    )
                    - datetime.now()
                )

                secs = max(
                    int(remain.total_seconds()),
                    0
                )

                nxt = f"{secs // 60}m"

            lines.append(
                f"  {color}●{C.RESET} "
                f"{t.name[:24]:<24} "
                f"{color}{t.status:<9}{C.RESET} "
                f"{C.DIM}"
                f"x{t.restarts:<3} "
                f"next {nxt:>5}"
                f"{C.RESET}"
            )

        lines.append(
            C.DIM + "=" * width + C.RESET
        )

        lines.append("")

        for entry in LOG_BUFFER[-8:]:
            lines.append(entry)

        lines.append("")

        lines.append(
            f"  {C.DIM}"
            f"Type anything + Enter, or Ctrl+C, "
            f"to stop"
            f"{C.RESET}"
        )

        return lines

    def _stdin_wants_stop(
        self,
        timeout: float
    ) -> bool:

        try:
            import select

            ready, _, _ = select.select(
                [sys.stdin],
                [],
                [],
                timeout
            )

        except Exception:
            time.sleep(timeout)
            return False

        if not ready:
            return False

        try:
            sys.stdin.readline()
        except Exception:
            return True

        return True

    def run(self) -> None:
        global LIVE_MODE

        prev_handlers = (
            signal.getsignal(signal.SIGINT),
            signal.getsignal(signal.SIGTERM)
        )

        signal.signal(
            signal.SIGINT,
            self.stop
        )

        signal.signal(
            signal.SIGTERM,
            self.stop
        )

        try:
            subprocess.run(
                ["termux-wake-lock"],
                capture_output=True,
                timeout=10
            )
        except Exception:
            pass

        LIVE_MODE = True
        LOG_BUFFER.clear()
        Screen.reset()

        clear()
        Screen.hide_cursor()

        logline(
            f"watchdog started on "
            f"{len(self.targets)} target(s)",
            "OK"
        )

        logline(
            "timer-only rejoin mode: "
            "crash/hang/dialog detection "
            "will NOT restart Roblox",
            "INFO"
        )

        logline(
            "press any key + Enter, "
            "or Ctrl+C, to stop",
            "INFO"
        )

        try:

            while self.running:

                for t in self.targets:

                    if not self.running:
                        break

                    try:
                        self.tick(t)

                    except Exception as e:
                        logline(
                            f"[{t.name}] error: {e}",
                            "ERR"
                        )

                    Screen.render(
                        self.frame()
                    )

                total = (
                    self.interval
                    + random.uniform(0, 3)
                )

                slept = 0.0

                while (
                    self.running
                    and slept < total
                ):

                    if self._stdin_wants_stop(0.4):
                        self.running = False
                        break

                    slept += 0.4

                    Screen.render(
                        self.frame()
                    )

        except KeyboardInterrupt:
            self.running = False

        finally:

            LIVE_MODE = False
            Screen.show_cursor()

            try:
                subprocess.run(
                    ["termux-wake-unlock"],
                    capture_output=True,
                    timeout=10
                )
            except Exception:
                pass

            signal.signal(
                signal.SIGINT,
                prev_handlers[0]
            )

            signal.signal(
                signal.SIGTERM,
                prev_handlers[1]
            )

        up = str(
            datetime.now() - self.started
        ).split(".")[0]

        total = sum(
            t.restarts
            for t in self.targets
        )

        print()

        ok(
            f"Stopped after {up} · "
            f"{total} restart(s) total"
        )


