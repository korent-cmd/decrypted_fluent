                "   [i] interval    "
                "[h] health detection    "
                "[s] save   [b] back\n"
            )

            cmd = ask(
                "choice"
            ).lower().strip()

            if cmd in ("b", ""):
                return

            if cmd == "s":

                save_config(
                    self.targets,
                    self.interval,
                    self.hang
                )

                ok("Saved.")

                time.sleep(0.8)

            elif cmd == "i":

                self.interval = ask_int(
                    "Check every N seconds",
                    self.interval,
                    5,
                    600
                )

            elif cmd == "h":

                self.hang = not self.hang

            elif cmd.startswith("t"):

                n = self._idx(cmd)

                if n is not None:
                    self.targets[n].enabled = (
                        not self.targets[n].enabled
                    )

            elif cmd.startswith("d"):

                n = self._idx(cmd)

                if n is not None:

                    removed = self.targets.pop(n)

                    ok(
                        f"Removed {removed.name}"
                    )

                    time.sleep(0.8)

            elif cmd.isdigit():

                n = int(cmd) - 1

                if 0 <= n < len(self.targets):
                    self._edit_target(
                        self.targets[n]
                    )

    def _idx(
        self,
        cmd: str
    ) -> Optional[int]:

        m = re.search(
            r"\d+",
            cmd
        )

        if not m:
            return None

        n = int(m.group()) - 1

        return (
            n
            if 0 <= n < len(self.targets)
            else None
        )

    def _edit_target(
        self,
        t: Target
    ) -> None:

        print()

        info(
            f"Editing {t.name}"
        )

        new = ask(
            "Place ID or game URL",
            t.place_id
        )

        parsed = parse_place_id(new)

        if parsed:
            t.place_id = parsed

        pl = ask(
            "Private server link "
            "(blank = none)",
            t.private_link
        )

        t.private_link = (
            parse_private_link(pl)
            or (
                pl
                if pl.isalnum()
                else ""
            )
        )

        t.rejoin_interval_min = ask_int(
            "Rejoin every N minutes "
            "(0 = off)",
            t.rejoin_interval_min,
            0
        )

        t.label = ask(
            "Display name",
            t.label or t.package
        )

        save_config(
            self.targets,
            self.interval,
            self.hang
        )

        ok("Saved.")

        time.sleep(0.8)

    # --------------------------------------------------------------------------
    # diagnostics
    # --------------------------------------------------------------------------

    def diagnostics(self) -> None:

        clear()

        print(
            f"  {C.BOLD}"
            f"DIAGNOSTICS"
            f"{C.RESET}\n"
        )

        hr()

        print(
            f"  {C.BOLD}"
            f"Root probe detail"
            f"{C.RESET} "
            f"(what actually happened, not just yes/no):"
        )

        for line in (
            self.sh.root_probe_detail
            or "(not run yet)"
        ).splitlines():

            print(
                f"   {C.DIM}"
                f"{line}"
                f"{C.RESET}"
            )

        print()

        if self.sh.has_root:

            ok("Root confirmed")

        else:

            err(
                "Root not confirmed by any "
                "invocation style above"
            )

            warn(
                "If `su -c id` works fine when "
                "you type it yourself in Termux,"
            )

            warn(
                "the most common cause is a "
                "root-grant prompt/notification "
                "that"
            )

            warn(
                "needs a manual tap the FIRST time "
                "a new process asks for su."
            )

            warn(
                "Try 'r' below right after tapping "
                "Allow/Grant."
            )

        print()

        hr()

        checks = [
            (
                "pm list users",
                "User profiles"
            ),
            (
                "pm list packages | wc -l",
                "Packages visible"
            ),
            (
                "dumpsys window | "
                "grep -m1 mCurrentFocus",
                "Foreground app"
            ),
            (
                "getprop ro.build.version.release",
                "Android version"
            ),
        ]

        for cmd, label in checks:

            out = self.sh.out(
                cmd,
                timeout=30
            ).strip()

            first = (
                out.splitlines()[0][:44]
                if out
                else ""
            )

            if (
                out
                and "not found" not in out.lower()
                and "denied" not in out.lower()
            ):

                ok(
                    f"{label:<18} "
                    f"{C.DIM}"
                    f"{first}"
                    f"{C.RESET}"
                )

            else:

                err(
                    f"{label:<18} "
                    f"{C.DIM}"
                    f"{first or 'no output'}"
                    f"{C.RESET}"
                )

        hr()

        print()

        self.troubleshoot_text()

        print(
            f"\n   [{C.BOLD}r{C.RESET}] "
            f"recheck root now   "
            f"[{C.BOLD}Enter{C.RESET}] back"
        )

        choice = ask("").strip().lower()

        if choice == "r":

            self.sh.has_root = (
                self.sh._probe_root()
            )

            self.diagnostics()

    @staticmethod
    def troubleshoot_text() -> None:

        print(
            f"  {C.BOLD}"
            f"If nothing is detected, try in order:"
            f"{C.RESET}"
        )

        print(
            f"   1. {C.DIM}"
            f"su -c id"
            f"{C.RESET} — must print uid=0, "
            f"else grant Termux root"
        )

        print(
            f"   2. {C.DIM}"
            f"su -c 'pm list users'"
            f"{C.RESET} — clones often live "
            f"on user 10/11"
        )

        print(
            "   3. Open Roblox first, then rescan "
            "— foreground detection catches it"
        )

        print(
            "   4. Add your cloner's name as an "
            "extra hint in the scan prompt"
        )

