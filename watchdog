class Shell:

    def __init__(self, prefer_root: bool = True):
        self.root_probe_detail = (
            "startup probe skipped (safe Termux mode)"
        )

        self.has_root = bool(prefer_root)
        self._cache: Dict[str, str] = {}

    def _probe_root(self) -> bool:
        attempts = [
            ["su", "-c", "id"],
            ["su", "-c", "id"],
            ["su", "0", "id"],
            ["su", "-mm", "-c", "id"],
        ]

        details = []

        for i, argv in enumerate(attempts):
            try:
                r = subprocess.run(
                    argv,
                    capture_output=True,
                    text=True,
                    timeout=20,
                    stdin=subprocess.DEVNULL,
                )

            except FileNotFoundError:
                details.append(
                    f"{' '.join(argv)} -> "
                    f"su binary not found on PATH"
                )
                break

            except subprocess.TimeoutExpired:
                details.append(
                    f"{' '.join(argv)} -> timed out after 20s "
                    f"(often means a root prompt is waiting for a tap)"
                )

                _resane_tty()

                if i == 0:
                    time.sleep(2)

                continue

            finally:
                _resane_tty()

            out = (r.stdout or "").strip()
            errtxt = (r.stderr or "").strip()

            details.append(
                f"{' '.join(argv)} -> rc={r.returncode} "
                f"stdout={out[:60]!r} "
                f"stderr={errtxt[:60]!r}"
            )

            if (
                r.returncode == 0
                and ("uid=0" in out or "uid=0" in errtxt)
            ):
                self.root_probe_detail = "\n".join(details)
                return True

        self.root_probe_detail = "\n".join(details)
        return False

    def run(
        self,
        cmd: str,
        timeout: int = 25,
        root: bool = True
    ) -> Tuple[int, str]:

        argv = (
            ["su", "-c", cmd]
            if (root and self.has_root)
            else ["sh", "-c", cmd]
        )

        try:
            r = subprocess.run(
                argv,
                capture_output=True,
                text=True,
                timeout=timeout,
                stdin=subprocess.DEVNULL,
            )

        except subprocess.TimeoutExpired:
            return 124, ""

        except FileNotFoundError:
            return 127, ""

        finally:
            if argv[0] == "su":
                _resane_tty()

        return (
            r.returncode,
            (r.stdout or "") + (r.stderr or "")
        )

    def out(
        self,
        cmd: str,
        timeout: int = 25,
        root: bool = True
    ) -> str:
        return self.run(cmd, timeout, root)[1]

    def cached(
        self,
        cmd: str,
        timeout: int = 45
    ) -> str:

        if cmd not in self._cache:
            self._cache[cmd] = self.out(cmd, timeout)

        return self._cache[cmd]

    def clear_cache(self) -> None:
        self._cache.clear()


