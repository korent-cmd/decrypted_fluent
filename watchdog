def save_config(targets: List[Target], interval: int, hang: bool) -> None:
    data = {"check_interval_sec": interval, "hang_detection": hang,
            "targets": [t.to_config() for t in targets]}
    with open(CONFIG_PATH, "w") as f:
        json.dump(data, f, indent=2)


def load_config() -> Tuple[List[Target], int, bool]:
    if not os.path.exists(CONFIG_PATH):
        return [], 20, True
    try:
        with open(CONFIG_PATH) as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError):
        return [], 20, True
    targets = []
    for raw in data.get("targets", []):
        try:
            targets.append(Target(**raw))
        except TypeError:
            continue
    return (targets, int(data.get("check_interval_sec", 20)),
            bool(data.get("hang_detection", True)))


def parse_place_id(raw: str) -> str:
    """Accepts a bare id or a full roblox game URL and extracts the place id."""
    raw = raw.strip()
    m = re.search(r"/games/(\d+)", raw)
    if m:
        return m.group(1)
    m = re.search(r"placeId=(\d+)", raw, re.I)
    if m:
        return m.group(1)
    digits = re.sub(r"\D", "", raw)
    return digits


def parse_private_link(raw: str) -> str:
    m = re.search(r"privateServerLinkCode=([A-Za-z0-9_-]+)", raw)
    return m.group(1) if m else ""


# ==============================================================================
# APP / MENUS
# ==============================================================================

class App:
    def __init__(self) -> None:
        self.sh = Shell()
        self.targets, self.interval, self.hang = load_config()

    # -- setup wizard ----------------------------------------------------------

    def wizard(self) -> None:
        clear()
        banner()
        print(f"  {C.BOLD}AUTO SETUP{C.RESET}\n")
        hr()

        # step 1 - root
        print(f"\n  {C.BOLD}Step 1/4 · Root access{C.RESET}")
        if self.sh.has_root:
            ok("Root confirmed (su works)")
        else:
            err("No root detected")
            warn("Without root, force-stop and rejoin will very likely fail.")
            warn("Open your root manager and grant Termux permission, then retry.")
            if not ask_yes("Continue anyway?", False):
                return

        # step 2 - detect
        print(f"\n  {C.BOLD}Step 2/4 · Finding Roblox{C.RESET}")
        deep = ask_yes("Run deep scan? (slower, finds renamed clones)", True)
        markers = None
        extra = ask("Extra name hints, space separated (optional)")
        if extra:
            markers = PACKAGE_MARKERS + extra.split()

        det = Detector(self.sh, markers)
        cands = det.detect(deep=deep)

        if not cands:
            err("No Roblox packages found.")
            print()
            self.troubleshoot_text()
            pause()
            return

        print()
        ok(f"Found {len(cands)} candidate(s):\n")
        for i, c in enumerate(cands, 1):
            mark = f"{C.GREEN}OK{C.RESET}" if c.confidence >= MIN_CONFIDENCE \
                else f"{C.YELLOW}? {C.RESET}"
            print(f"   {i:>2}. [{mark}] {c.display}")
            print(f"       {C.DIM}{c.package} · user {c.user_id} · "
                  f"matched by: {','.join(sorted(c.strategies))}{C.RESET}")

        print()
        sel = ask("Which to watch? (numbers, 'a' for all confident ones)", "a")
        if sel.lower().startswith("a"):
            chosen = [c for c in cands if c.confidence >= MIN_CONFIDENCE] or cands
        else:
            idxs = [int(x) for x in re.findall(r"\d+", sel)]
            chosen = [cands[i - 1] for i in idxs if 1 <= i <= len(cands)]
        if not chosen:
            err("Nothing selected.")
            pause()
            return
        ok(f"Selected {len(chosen)} instance(s)")

        # step 3 - place id
        print(f"\n  {C.BOLD}Step 3/4 · Where to farm{C.RESET}")
        info("Paste a game URL or just the place ID.")
        place = ""
        while not place:
            place = parse_place_id(ask("Game URL or place ID"))
            if not place:
                warn("Couldn't read a place ID from that.")
        priv = parse_private_link(ask("Private server link (optional, Enter to skip)"))
        ok(f"Place ID: {place}" + (f" · private server: {priv}" if priv else ""))

        same = True
        if len(chosen) > 1:
            same = ask_yes("Use this place for every instance?", True)

        # step 4 - timing
        print(f"\n  {C.BOLD}Step 4/4 · Timing{C.RESET}")
        rejoin = ask_int("Force rejoin every N minutes (0 = only on crash)", 45, 0)
        interval = ask_int("Check health every N seconds", 20, 5, 600)
        hang = ask_yes("Also restart frozen (not-crashed) instances?", True)

        targets: List[Target] = []
        for c in chosen:
            p, pv = place, priv
            if not same:
                print(f"\n  {C.DIM}for {c.display}{C.RESET}")
                p = parse_place_id(ask("Place ID", place)) or place
                pv = parse_private_link(ask("Private link (optional)")) or ""
            targets.append(Target(package=c.package, user_id=c.user_id, place_id=p,
                                  private_link=pv, rejoin_interval_min=rejoin,
                                  label=c.label or ""))

        self.targets, self.interval, self.hang = targets, interval, hang
        save_config(targets, interval, hang)
        print()
        ok(f"Saved to {os.path.basename(CONFIG_PATH)}")
        hr()
        for t in targets:
            print(f"   · {t.name} -> place {t.place_id}, rejoin {t.rejoin_interval_min}m")
        hr()

        if ask_yes("\n  Start the watchdog now?", True):
            self.start()
        else:
            pause()

    # -- run -------------------------------------------------------------------

    def start(self) -> None:
        if not self.targets:
            err("Nothing configured yet. Run Auto setup (option 1) first.")
            pause()
            return
        bad = [t for t in self.targets if not t.place_id]
        if bad:
            err(f"{len(bad)} target(s) have no place ID set.")
            pause()
            return
        wd = Watchdog(self.sh, self.targets, self.interval, self.hang)
        wd.run()
        pause()

    # -- detect only -----------------------------------------------------------

    def detect_only(self) -> None:
        clear()
        print(f"  {C.BOLD}PACKAGE SCAN{C.RESET}\n")
        hr()
        deep = ask_yes("Deep scan?", True)
        extra = ask("Extra name hints (optional)")
        markers = PACKAGE_MARKERS + extra.split() if extra else None
        print()
        det = Detector(self.sh, markers)
        cands = det.detect(deep=deep)
        print()
        hr("=")
        print(f"  root: {self.sh.has_root}   foreground: {det.foreground() or '?'}")
        hr("=")
        if not cands:
            err("Nothing found.")
            print()
            self.troubleshoot_text()
        for i, c in enumerate(cands, 1):
            mark = f"{C.GREEN}OK{C.RESET}" if c.confidence >= MIN_CONFIDENCE \
                else f"{C.YELLOW}? {C.RESET}"
            print(f"   {i:>2}. [{mark}] {c.package}")
            print(f"       {C.DIM}{c.display} · user {c.user_id} · conf "
                  f"{c.confidence} · {','.join(sorted(c.strategies))}{C.RESET}")
        pause()

    # -- config editor ---------------------------------------------------------

    def edit_config(self) -> None:
        while True:
            clear()
            print(f"  {C.BOLD}CONFIGURED INSTANCES{C.RESET}\n")
            hr()
            if not self.targets:
                warn("No instances configured.")
            for i, t in enumerate(self.targets, 1):
                state = f"{C.GREEN}on {C.RESET}" if t.enabled else f"{C.DIM}off{C.RESET}"
                print(f"   {i:>2}. [{state}] {t.name}")
                print(f"       {C.DIM}place {t.place_id or '(unset)'} · "
                      f"rejoin {t.rejoin_interval_min}m · user {t.user_id}{C.RESET}")
            hr()
            print(f"   {C.DIM}check interval {self.interval}s · "
                  f"hang detection {'on' if self.hang else 'off'}{C.RESET}\n")
            print("   [number] edit   [t N] toggle on/off   [d N] delete")
            print("   [i] interval    [h] hang detection    [s] save   [b] back\n")
            cmd = ask("choice").lower().strip()

            if cmd in ("b", ""):
                return
            if cmd == "s":
                save_config(self.targets, self.interval, self.hang)
                ok("Saved.")
                time.sleep(0.8)
            elif cmd == "i":
                self.interval = ask_int("Check every N seconds", self.interval, 5, 600)
            elif cmd == "h":
                self.hang = not self.hang
            elif cmd.startswith("t"):
                n = self._idx(cmd)
                if n is not None:
                    self.targets[n].enabled = not self.targets[n].enabled
            elif cmd.startswith("d"):
                n = self._idx(cmd)
                if n is not None:
                    removed = self.targets.pop(n)
                    ok(f"Removed {removed.name}")
                    time.sleep(0.8)
            elif cmd.isdigit():
                n = int(cmd) - 1
                if 0 <= n < len(self.targets):
                    self._edit_target(self.targets[n])

    def _idx(self, cmd: str) -> Optional[int]:
        m = re.search(r"\d+", cmd)
        if not m:
            return None
        n = int(m.group()) - 1
        return n if 0 <= n < len(self.targets) else None

    def _edit_target(self, t: Target) -> None:
        print()
        info(f"Editing {t.name}")
        new = ask("Place ID or game URL", t.place_id)
        parsed = parse_place_id(new)
        if parsed:
            t.place_id = parsed
        pl = ask("Private server link (blank = none)", t.private_link)
        t.private_link = parse_private_link(pl) or (pl if pl.isalnum() else "")
        t.rejoin_interval_min = ask_int("Rejoin every N minutes (0 = off)",
                                        t.rejoin_interval_min, 0)
        t.label = ask("Display name", t.label or t.package)
        save_config(self.targets, self.interval, self.hang)
        ok("Saved.")
        time.sleep(0.8)

    # -- diagnostics -----------------------------------------------------------

    def diagnostics(self) -> None:
        clear()
        print(f"  {C.BOLD}DIAGNOSTICS{C.RESET}\n")
        hr()
        checks = [
            ("su -c id", "Root access"),
            ("pm list users", "User profiles"),
            ("pm list packages | wc -l", "Packages visible"),
            ("dumpsys window | grep -m1 mCurrentFocus", "Foreground app"),
            ("getprop ro.build.version.release", "Android version"),
        ]
        for cmd, label in checks:
            out = self.sh.out(cmd, timeout=30).strip()
            first = out.splitlines()[0][:44] if out else ""
            if out and "not found" not in out.lower() and "denied" not in out.lower():
                ok(f"{label:<18} {C.DIM}{first}{C.RESET}")
            else:
                err(f"{label:<18} {C.DIM}{first or 'no output'}{C.RESET}")
        hr()
        print()
        self.troubleshoot_text()
        pause()

    @staticmethod
    def troubleshoot_text() -> None:
        print(f"  {C.BOLD}If nothing is detected, try in order:{C.RESET}")
        print(f"   1. {C.DIM}su -c id{C.RESET} — must print uid=0, else grant Termux root")
        print(f"   2. {C.DIM}su -c 'pm list users'{C.RESET} — clones often live on user 10/11")
        print("   3. Open Roblox first, then rescan — foreground detection catches it")
        print("   4. Add your cloner's name as an extra hint in the scan prompt")

    # -- main menu -------------------------------------------------------------

    def menu(self) -> None:
        while True:
            clear()
            banner()
            n = len(self.targets)
            root_s = f"{C.GREEN}root ok{C.RESET}" if self.sh.has_root \
                else f"{C.RED}no root{C.RESET}"
            cfg_s = (f"{C.GREEN}{n} instance(s) configured{C.RESET}" if n
                     else f"{C.YELLOW}not configured{C.RESET}")
            print(f"   status: {root_s}  ·  {cfg_s}\n")
            hr("=")
            print(f"   {C.BOLD}1{C.RESET}  Auto setup        "
                  f"{C.DIM}find Roblox, pick a game, save{C.RESET}")
            print(f"   {C.BOLD}2{C.RESET}  Start watchdog    "
                  f"{C.DIM}begin auto-rejoin monitoring{C.RESET}")
            print(f"   {C.BOLD}3{C.RESET}  Scan packages     "
                  f"{C.DIM}detection report only{C.RESET}")
            print(f"   {C.BOLD}4{C.RESET}  Edit instances    "
                  f"{C.DIM}place IDs, timing, on/off{C.RESET}")
            print(f"   {C.BOLD}5{C.RESET}  Diagnostics       "
                  f"{C.DIM}why isn't it finding anything{C.RESET}")
            print(f"   {C.BOLD}0{C.RESET}  Exit")
            hr("=")
            choice = ask("\n  select").strip()

            if choice == "1":
                self.wizard()
            elif choice == "2":
                self.start()
            elif choice == "3":
                self.detect_only()
            elif choice == "4":
                self.edit_config()
            elif choice == "5":
                self.diagnostics()
            elif choice in ("0", "q", "exit"):
                print(f"\n  {C.DIM}bye{C.RESET}\n")
                return


def main() -> int:
    # Headless shortcut: `python3 rw.py start` skips the menu (for cron/boot).
    if len(sys.argv) > 1 and sys.argv[1] in ("start", "run"):
        app = App()
        if not app.targets:
            err("No config found. Run without arguments to set up.")
            return 1
        Watchdog(app.sh, app.targets, app.interval, app.hang).run()
        return 0
    try:
        App().menu()
    except KeyboardInterrupt:
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
