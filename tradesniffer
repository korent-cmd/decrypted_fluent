--[[
  Blox Fruits - Trade Process Sniffer (with GUI)
  Run in executor. No console/output needed: a draggable GUI shows the live log,
  with Copy (clipboard) and Save (writefile) buttons. Every boot step reports
  into the GUI so you can see exactly where it is / if it fails.

  BUTTONS: Pause/Resume, Clear, Copy, Save, Filter box (substring on instance path).
  LOGS:    OUT:REQ / OUT:RES  (client -> server), IN:EVENT (server -> client),
           SIT (seat name + CFrame), PROMPT, KEY, BOOT.
  CTRL:    _G.StartSniff() / _G.StopSniff() / _G.SniffToFile=true (writes trade_sniff.log)

  Remotes live under ReplicatedStorage.Remotes (CommF_, TradeFunction, TradeEvent).
--]]

_G.SniffEnabled = true
_G.SniffCaptureOutgoing = _G.SniffCaptureOutgoing == true
_G.SniffFilter = type(_G.SniffFilter) == "string" and _G.SniffFilter or "Trade"
if _G.SniffFilter == "" then
	_G.SniffFilter = "Trade"
end
_G.SniffDepth = _G.SniffDepth or 4
_G.SniffDisplayLines = _G.SniffDisplayLines or 400

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

-- ------------------------------------------------------------------
-- log storage
-- ------------------------------------------------------------------
local logBuffer = {}
local logCount = 0
local dirty = false

local function addLine(tag, msg)
	pcall(function()
		logCount = logCount + 1
		local stamp = tostring(os.clock()):sub(1, 6)
		logBuffer[logCount] = string.format("[SNIFF:%s] %ss  %s", tag, stamp, msg)
	end)
	dirty = true
end

local function getFullLog()
	return table.concat(logBuffer, "\n")
end

local function getVisibleLog()
	local top = math.max(1, logCount - (_G.SniffDisplayLines or 400) + 1)
	local parts = {}
	for i = top, logCount do
		parts[#parts + 1] = logBuffer[i]
	end
	return table.concat(parts, "\n")
end

-- ------------------------------------------------------------------
-- serialization
-- ------------------------------------------------------------------
local function serialize(v)
	local seen = {}

	local function ser(x, depth)
		local t = typeof(x)
		if t == "Instance" then
			local ok, path = pcall(function()
				return x:GetFullName()
			end)
			return x.ClassName .. ">" .. (ok and path or "?")
		elseif t == "table" then
			if depth > _G.SniffDepth then
				return "{...}"
			end
			if seen[x] then
				return "{loop}"
			end
			if not next(x) then
				return "{}"
			end
			seen[x] = true
			local parts = {}
			for k, val in pairs(x) do
				table.insert(parts, ser(k, depth + 1) .. "=" .. ser(val, depth + 1))
			end
			seen[x] = nil
			return "{" .. table.concat(parts, ", ") .. "}"
		elseif t == "function" then
			return "function"
		elseif t == "string" then
			return ("%q"):format(x)
		else
			return tostring(x)
		end
	end

	local ok, result = pcall(function()
		return ser(v, 0)
	end)
	return ok and result or "(unserializable)"
end

local function joinArgs(...)
	local parts = {}
	for i = 1, select("#", ...) do
		parts[i] = serialize((select(i, ...)))
	end
	return table.concat(parts, ", ")
end

-- ------------------------------------------------------------------
-- filter / emit
-- ------------------------------------------------------------------
local function shouldLog(inst)
	if not _G.SniffEnabled then
		return false
	end
	local f = _G.SniffFilter
	if not f or f == "" then
		return true
	end
	local ok, path = pcall(function()
		return inst:GetFullName()
	end)
	return ok and path:lower():find(f:lower(), 1, true) ~= nil
end

local function logReq(inst, method, ...)
	if shouldLog(inst) then
		addLine("OUT:REQ", string.format("%s :: %s(%s)", inst:GetFullName(), method, joinArgs(...)))
	end
end

local function logRes(inst, method, ...)
	if shouldLog(inst) then
		addLine("OUT:RES", string.format("%s :: %s -> %s", inst:GetFullName(), method, joinArgs(...)))
	end
end

-- ------------------------------------------------------------------
-- 1) outgoing: namecall hook (call the original exactly once)
-- ------------------------------------------------------------------
local namecallHooked = false
local oldNamecall

local function tryHookNamecall()
	if not _G.SniffCaptureOutgoing then
		return false
	end
	if not hookmetamethod or not getnamecallmethod then
		return false
	end

	local wrap = newcclosure or (function(f)
		return f
	end)

	oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
		local method = getnamecallmethod()

		if method == "FireServer" or method == "InvokeServer" then
			local ok, isRemote = pcall(function()
				return self and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction"))
			end)
			if ok and isRemote then
				logReq(self, method, ...)
				if method == "InvokeServer" then
					local results = { oldNamecall(self, ...) }
					logRes(self, method, table.unpack(results))
					return table.unpack(results)
				end
			end
		end

		return oldNamecall(self, ...)
	end))

	namecallHooked = true
	return true
end

-- ------------------------------------------------------------------
-- 2) outgoing: per-instance wrap (fallback, only if namecall hook failed)
-- ------------------------------------------------------------------
local wrapDone = {}

local function wrapInstance(inst)
	if wrapDone[inst] then
		return
	end
	wrapDone[inst] = true

	if inst:IsA("RemoteFunction") then
		local ok, old = pcall(function()
			return inst.InvokeServer
		end)
		if not ok or type(old) ~= "function" then
			return
		end
		inst.InvokeServer = function(self, ...)
			logReq(self, "InvokeServer", ...)
			local results = { old(self, ...) }
			logRes(self, "InvokeServer", table.unpack(results))
			return table.unpack(results)
		end
	elseif inst:IsA("RemoteEvent") then
		local ok, old = pcall(function()
			return inst.FireServer
		end)
		if not ok or type(old) ~= "function" then
			return
		end
		inst.FireServer = function(self, ...)
			logReq(self, "FireServer", ...)
			return old(self, ...)
		end
	end
end

-- ------------------------------------------------------------------
-- 3) incoming
-- ------------------------------------------------------------------
local hookedIncoming = {}

local function hookIncoming(inst)
	if hookedIncoming[inst] then
		return
	end
	hookedIncoming[inst] = true
	pcall(function()
		inst.OnClientEvent:Connect(function(...)
			if shouldLog(inst) then
				addLine("IN:EVENT", string.format("%s | %s", inst:GetFullName(), joinArgs(...)))
			end
		end)
	end)
end

-- ------------------------------------------------------------------
-- 4) sits / prompts / keys
-- ------------------------------------------------------------------
local function hookHumanoid(hum)
	if not hum then
		return
	end
	if hum:GetAttribute("SniffSitHooked") then
		return
	end
	hum:SetAttribute("SniffSitHooked", true)
	hum.Seated:Connect(function(seated, seat)
		if not _G.SniffEnabled then
			return
		end
		if seated and seat then
			local ok, cf = pcall(function()
				return tostring(seat.CFrame)
			end)
			addLine("SIT", string.format("SAT on %s | CFrame=%s", seat:GetFullName(), ok and cf or "?"))
		else
			addLine("SIT", "stood up")
		end
	end)
end

local function describeOccupant(seat)
	local occupant = seat.Occupant
	if not occupant then
		return "empty"
	end
	local character = occupant.Parent
	local player = character and Players:GetPlayerFromCharacter(character)
	if player then
		return string.format("%s (%s, UserId=%d)", player.Name, player.DisplayName, player.UserId)
	end
	return string.format("unknown humanoid %s", character and character:GetFullName() or "?")
end

local function hookTradeSeat(seat)
	if not seat:IsA("Seat") and not seat:IsA("VehicleSeat") then
		return
	end
	if not seat:IsDescendantOf(Workspace:FindFirstChild("Map") or Workspace) then
		return
	end
	if not seat:GetFullName():lower():find("tradetable", 1, true) then
		return
	end
	if seat:GetAttribute("SniffTradeSeatHooked") then
		return
	end
	seat:SetAttribute("SniffTradeSeatHooked", true)
	local function report()
		addLine("TRADE:SEAT", string.format("%s occupant=%s", seat:GetFullName(), describeOccupant(seat)))
	end
	pcall(function()
		seat:GetPropertyChangedSignal("Occupant"):Connect(report)
	end)
	report()
end

local function scanTradeSeats()
	local count = 0
	pcall(function()
		for _, inst in ipairs(Workspace:GetDescendants()) do
			if inst:IsA("Seat") or inst:IsA("VehicleSeat") then
				local path = inst:GetFullName():lower()
				if path:find("tradetable", 1, true) then
					hookTradeSeat(inst)
					count = count + 1
				end
			end
		end
	end)
	return count
end

local function hookTradeGuiObject(inst)
	local name = inst:GetFullName():lower()
	if not name:find("trade", 1, true) then
		return
	end
	if inst:GetAttribute("SniffTradeGuiHooked") then
		return
	end
	inst:SetAttribute("SniffTradeGuiHooked", true)
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		local function report()
			local text = inst.Text
			if text and text ~= "" then
				addLine("TRADE:UI", string.format("%s text=%q", inst:GetFullName(), text))
			end
		end
		pcall(function()
			inst:GetPropertyChangedSignal("Text"):Connect(report)
		end)
		report()
	end
	pcall(function()
		inst.ChildAdded:Connect(function(child)
			addLine("TRADE:UI", "added " .. child:GetFullName())
			hookTradeGuiObject(child)
		end)
	end)
end

local function scanTradeGui()
	local lp = Players.LocalPlayer
	local pg = lp and lp:FindFirstChild("PlayerGui")
	if not pg then
		return 0
	end
	local count = 0
	pcall(function()
		for _, inst in ipairs(pg:GetDescendants()) do
			if inst:GetFullName():lower():find("trade", 1, true) then
				hookTradeGuiObject(inst)
				count = count + 1
			end
		end
		pg.DescendantAdded:Connect(function(inst)
			if inst:GetFullName():lower():find("trade", 1, true) then
				hookTradeGuiObject(inst)
			end
		end)
	end)
	return count
end

local function hookPrompt(p)
	if not p:IsA("ProximityPrompt") then
		return
	end
	if p:GetAttribute("SniffPromptHooked") then
		return
	end
	p:SetAttribute("SniffPromptHooked", true)
	pcall(function()
		p.PromptShown:Connect(function()
			if _G.SniffEnabled then
				addLine("PROMPT", string.format("shown %s | key=%s | action=%s | obj=%s",
					p:GetFullName(), tostring(p.KeyboardKeyCode), tostring(p.ActionText), tostring(p.ObjectText)))
			end
		end)
		p.Triggered:Connect(function()
			if _G.SniffEnabled then
				addLine("PROMPT", string.format("TRIGGERED %s | action=%s", p:GetFullName(), tostring(p.ActionText)))
			end
		end)
	end)
end

local function initCharacter(char)
	if not char then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hookHumanoid(hum)
	end
end

-- ------------------------------------------------------------------
-- 5) scanning / watching (lazy, yields so it can't hang)
-- ------------------------------------------------------------------
local function scanRemotes()
	local remotes = ReplicatedStorage and ReplicatedStorage:FindFirstChild("Remotes")
	local n = 0
	local seen = {}
	if not remotes then
		addLine("BOOT", "ReplicatedStorage.Remotes is not visible yet")
		return 0
	end
	for _, inst in ipairs(remotes:GetChildren()) do
		if inst:IsA("RemoteEvent") then
			hookIncoming(inst)
			if _G.SniffCaptureOutgoing and not namecallHooked then
				wrapInstance(inst)
			end
			seen[inst] = true
			n = n + 1
		elseif inst:IsA("RemoteFunction") then
			if _G.SniffCaptureOutgoing and not namecallHooked then
				wrapInstance(inst)
			end
			seen[inst] = true
			n = n + 1
		end
	end
	-- Probe the known trade remotes directly without recursively scanning the game.
	for _, remoteName in ipairs({"TradeEvent", "TradeFunction", "CommF_"}) do
		local ok, inst = pcall(function()
			return remotes:FindFirstChild(remoteName)
		end)
		if ok and inst and not seen[inst] then
			if inst:IsA("RemoteEvent") then
				hookIncoming(inst)
				if _G.SniffCaptureOutgoing and not namecallHooked then
					wrapInstance(inst)
				end
			elseif inst:IsA("RemoteFunction") and _G.SniffCaptureOutgoing and not namecallHooked then
				wrapInstance(inst)
			end
			addLine("BOOT", "direct probe found " .. inst:GetFullName() .. " (" .. inst.ClassName .. ")")
			seen[inst] = true
			n = n + 1
		end
	end
	addLine("BOOT", string.format("remote scan root=%s | events/functions=%d",
		remotes:GetFullName(), n))
	return n
end

local function waitAndScanRemotes()
	for attempt = 1, 20 do
		local count = scanRemotes()
		if count > 0 then
			addLine("BOOT", string.format("delayed remote scan found %d remotes on attempt %d", count, attempt))
			return count
		end
		task.wait(1)
	end
	addLine("BOOT", "WARNING: no RemoteEvent/RemoteFunction instances found after 20 seconds")
	return 0
end

local function hookNew(shouldWrap)
	pcall(function()
		ReplicatedStorage.DescendantAdded:Connect(function(inst)
			if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
				if inst:IsA("RemoteEvent") then
					hookIncoming(inst)
					if shouldWrap then
						wrapInstance(inst)
					end
				elseif inst:IsA("RemoteFunction") then
					if shouldWrap then
						wrapInstance(inst)
					end
				end
			end
		end)
	end)
	pcall(function()
		local map = Workspace:FindFirstChild("Map")
		local tableModel = map and map:FindFirstChild("TradeTable", true)
		if tableModel then
			for _, inst in ipairs(tableModel:GetChildren()) do
				if inst:IsA("ProximityPrompt") then
					hookPrompt(inst)
				elseif inst:IsA("Seat") or inst:IsA("VehicleSeat") then
					hookTradeSeat(inst)
				end
			end
			tableModel.ChildAdded:Connect(function(inst)
				if inst:IsA("ProximityPrompt") then
					hookPrompt(inst)
				elseif inst:IsA("Seat") or inst:IsA("VehicleSeat") then
					hookTradeSeat(inst)
				end
			end)
		end
	end)
	local lp = Players.LocalPlayer
	if lp then
		pcall(function()
			lp.CharacterAdded:Connect(initCharacter)
		end)
		pcall(function()
			if lp.Character then
				initCharacter(lp.Character)
			end
		end)
	end
end

