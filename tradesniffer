minimizeBtn.Parent = topBar
status.Parent = root
filterBox.Parent = root
logBox.Parent = root

local parentGui = nil
pcall(function()
	local lp = Players.LocalPlayer
	if lp then
		parentGui = lp:FindFirstChild("PlayerGui") or parentGui
	end
end)
if not parentGui then
	parentGui = ReplicatedStorage
end
gui.Parent = parentGui
root.Parent = gui
minimizedIcon.Parent = gui

-- keys
pcall(function()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Return then
			if _G.SniffEnabled then
				addLine("KEY", "pressed " .. tostring(input.KeyCode))
			end
		end
	end)
end)

-- render loop (throttled, guarded)
local lastPaint = 0
RunService.Heartbeat:Connect(function(dt)
	if not gui or not gui.Parent then
		return
	end
	lastPaint = lastPaint + dt
	if lastPaint < 0.1 then
		return
	end
	lastPaint = 0
	sizeHint.Text = string.format("%d lines", logCount)
	if dirty then
		local ok, text = pcall(getVisibleLog)
		if ok then
			logBox.Text = text
		end
		dirty = false
	end
end)

-- ------------------------------------------------------------------
-- controls / helpers
-- ------------------------------------------------------------------
_G.StopSniff = function()
	_G.SniffEnabled = false
end
_G.StartSniff = function()
	_G.SniffEnabled = true
end
_G.SniffToggleGui = function()
	if root.Visible then
		minimize()
	else
		restore()
	end
end

local function setStatus(msg)
	status.Text = msg
	addLine("BOOT", msg)
	dirty = true
	logBox.Text = getVisibleLog()
end

-- note in GUI so the user isn't stuck if an error occurs mid-boot
local function handleBootError(err)
	pcall(function()
		status.Text = "BOOT ERROR: " .. tostring(err)
	end)
end

-- ------------------------------------------------------------------
-- boot (guarded step by step)
-- ------------------------------------------------------------------
local ok, err = pcall(function()
	setStatus("step 1: hooking namecall...")
	local okHook = pcall(tryHookNamecall)

	setStatus(string.format("step 2: scanning remotes (outgoing=%s)...",
		_G.SniffCaptureOutgoing and "enabled" or "passive"))
	local nRemotes = 0
	pcall(function()
		nRemotes = scanRemotes()
	end)
	if nRemotes == 0 then
		setStatus("no remotes yet; retrying for 20 seconds...")
		task.spawn(function()
			waitAndScanRemotes()
		end)
	end

	setStatus("step 3: hooking additions...")
	pcall(function()
		hookNew(_G.SniffCaptureOutgoing and not namecallHooked)
	end)

	setStatus("step 4: watching the trade table...")
	local tradeSeats = 0
	pcall(function()
		local map = Workspace:FindFirstChild("Map")
		local tableModel = map and map:FindFirstChild("TradeTable", true)
		if tableModel then
			for _, inst in ipairs(tableModel:GetChildren()) do
				if inst:IsA("Seat") or inst:IsA("VehicleSeat") then
					hookTradeSeat(inst)
					tradeSeats = tradeSeats + 1
				end
			end
		end
	end)
	local tradeGuiObjects = 0
	-- Do not scan PlayerGui or attach recursive listeners here; the GUI can be huge.

	setStatus(string.format("READY. remotes=%d | seats=%d | gui=%d | mode=%s | filter=%q | sit at the table now.",
		nRemotes, tradeSeats, tradeGuiObjects, _G.SniffCaptureOutgoing and (namecallHooked and "outgoing" or "fallback") or "passive", tostring(_G.SniffFilter)))
	if not _G.SniffCaptureOutgoing then
		addLine("BOOT", "PASSIVE MODE: incoming TradeEvent and seat tracking enabled; outgoing calls are untouched")
	elseif not namecallHooked then
		addLine("BOOT", "WARNING: outbound capture unavailable; incoming TradeEvent tracking remains active")
		status.Text = "READY: incoming-only mode"
	end
end)
if not ok then
	handleBootError(err)
end
