makeButton("Copy", 326, 82, Color3.fromRGB(55, 90, 150), function()
	local text = getFullLog()
	if #text == 0 then
		status.Text = "nothing to copy yet"
		return
	end
	local done = false
	if setclipboard then
		done = pcall(setclipboard, text)
	end
	if not done and clipboard and clipboard.set then
		done = pcall(function()
			clipboard.set(text)
		end)
	end
	status.Text = done and ("copied " .. logCount .. " lines") or "copy failed (no clipboard api)"
end)

makeButton("Save", 416, 92, Color3.fromRGB(60, 120, 60), function()
	local text = getFullLog()
	if #text == 0 then
		status.Text = "nothing to save yet"
		return
	end
	local ok, err = pcall(function()
		local name = "trade_sniff_" .. tostring(os.time()) .. ".log"
		writefile(name, "Trade Sniffer log\nfilter=" .. tostring(_G.SniffFilter)
			.. " | lines=" .. logCount .. "\n" .. text)
		status.Text = "saved -> " .. name .. " (executor workspace)"
	end)
	if not ok then
		status.Text = "save failed (no writefile): " .. tostring(err)
	end
end)

